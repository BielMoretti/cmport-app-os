{
  "expo": {
    "name": "CMPort OS",
    "slug": "cmport-app-os",
    "owner": "biel.pedretti",
    "scheme": "cmportos",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "br.com.cmport.os",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.cmport.os",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O CMPort OS registra onde você estava ao chegar e ao concluir cada OS. Só com o app aberto."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O CMPort OS usa a câmera para as fotos do serviço (antes e depois).",
          "photosPermission": "O CMPort OS usa as suas fotos só para anexar ao serviço.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "O CMPort OS usa a câmera para as fotos do serviço e para ler o QR das etiquetas.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1E3A8A",
          "defaultChannel": "os"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O CMPort OS grava o áudio que você manda na OS (relato ou recado ao escritório). Só quando você toca em gravar."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cce445b1-75f1-454a-9976-1335f374356d"
      }
    }
  }
}
